# Replace these documentation addresses with your server's real addresses.
# Public addresses must be the addresses clients see after any server-side NAT.
# Bind addresses must exist on the host. Two-address mode needs both IPs on one host.
CODSTUN_ARGS="--bind 0.0.0.0 --public-ip 192.0.2.10 --mode adaptive --relay-ports 20000-20199 --event-log /var/lib/codstun/events.jsonl"

# For direct discovery with one public address:
# CODSTUN_ARGS="--bind 0.0.0.0 --public-ip 192.0.2.10"
# For full physical NAT classification with two addresses, without relay mode:
# CODSTUN_ARGS="--bind 192.0.2.10 --public-ip 192.0.2.10 --secondary-bind 192.0.2.11 --secondary-public-ip 192.0.2.11"
