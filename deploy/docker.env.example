# Copy to /opt/codstun/shared/runtime.env, mode 0600; never commit the real file.
CODSTUN_PUBLIC_IP=192.0.2.10
CODSTUN_MODE=adaptive
CODSTUN_DIRECT_WINDOW=1.0
CODSTUN_LOG_BYTES=20971520
CODSTUN_LOG_BACKUPS=10
CODSTUN_TRAFFIC_INTERVAL=10
CODSTUN_PACKET_SAMPLES=8
CODSTUN_RELAY_PORTS=20000-20199
CODSTUN_LOG_DIR=/opt/codstun/shared/logs
